//   visual_hints = nextpt_color=white, nextpt_lcolor=khaki
//   visual_hints = edge_color=orange, vertex_color=white
//   visual_hints = edge_size=1, vertex_size=2
// }

Behavior = BHV_Waypoint
 {
   name         = survey
   pwt          = 100            
   condition    = MODE==SURVEYING
   endflag      = RETURN = true

      capture_radius = 3                       // default
        capture_line = false                   // default
       lead_to_start = false                   // default
               order = normal                  // default 
              repeat = 0                       // default
         slip_radius = 15                      // default
               speed = 1.2                     // default is zero
             updates = GEN_PATH
 }


//----------------------------------------------
Behavior = BHV_Waypoint
{
  name      = waypt_return
  pwt       = 100
  condition = MODE==RETURNING
  endflag   = STATION_KEEP = true
  perpetual = true

      speed = 1.3
     radius = 3.0
  nm_radius = 15.0
     points = $(START_POS)
       lead = 8
}

//----------------------------------------------
Behavior = BHV_StationKeep
{
  name      = station-keep
  pwt       = 100
  condition = MODE==STATION-KEEPING

   center_activate = true
      inner_radius = 5
      outer_radius = 10 
       outer_speed = 1.0
     transit_speed = 1.3
        swing_time = 7
      visual_hints = vertex_size=0, edge_color=gray50
}


Behavior = BHV_StationKeep
{
  name      = refueling-station
  pwt       = 100
  condition = MODE==REFUELING
  endflag   = REFUEL_NEEDED = false
  endflag   = STATION_KEEP  = false
  endflag   = RETURN        = false
  duration  = 60
  perpetual = true
  duration_idle_decay = false

   center_activate = true
      inner_radius = 5
      outer_radius = 10 
       outer_speed = 1.0
     transit_speed = 1.3
        swing_time = 7
      visual_hints = vertex_size=0, edge_color=gray50
}

//----------------------------------------------
Behavior = BHV_Timer
 {
   // General Behavior Parameters
   // ---------------------------
   name         = need-fuel-timer
   condition    = REFUEL_NEEDED = false
   condition    = STATION_KEEP  = false
   duration     = 600
   endflag      = REFUEL_NEEDED = true
   endflag      = RETURN        = true
   perpetual    = true
   duration_idle_decay = false
 }